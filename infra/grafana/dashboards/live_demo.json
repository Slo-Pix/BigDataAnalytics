{
  "uid": "live-demo",
  "title": "Live Demo \u2014 speed layer",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "torrent-bda",
    "streaming"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Torrents tracked",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT infohash) FROM demo.swarm_latest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Seeders right now (max over trackers)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(s) FROM (SELECT max(seeders) s FROM demo.swarm_latest GROUP BY infohash) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Rows ingested (selected range)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(rows) FROM demo.swarm_minute WHERE $__timeFilter(minute)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Micro-batches applied",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM demo.stream_batches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Stream throughput: scrape rows per minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT minute AS time, sum(rows) AS rows FROM demo.swarm_minute\n                 WHERE $__timeFilter(minute) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Average seeders per torrent, by tracker (per minute)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT minute AS time, tracker,\n                        sum(total_seeders)::float / nullif(sum(rows), 0) AS avg_seeders\n                 FROM demo.swarm_minute WHERE $__timeFilter(minute) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "title": "Largest swarms right now",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(t.title, l.infohash) AS torrent, t.category,\n                        max(l.seeders) AS seeders, max(l.leechers) AS leechers, max(l.completed) AS completed,\n                        max(l.scraped_at) AS last_seen\n                 FROM demo.swarm_latest l LEFT JOIN torrents t USING (infohash)\n                 GROUP BY 1, 2 ORDER BY seeders DESC LIMIT 25"
        }
      ]
    },
    {
      "id": 8,
      "title": "Seeders by category right now",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(s) FILTER (WHERE category = 'movie') AS movie, sum(s) FILTER (WHERE category = 'tv') AS tv,\n                        sum(s) FILTER (WHERE category = 'game') AS game, sum(s) FILTER (WHERE category IS NULL) AS unmatched\n                 FROM (SELECT infohash, max(seeders) s FROM demo.swarm_latest GROUP BY 1) l\n                 LEFT JOIN torrents t USING (infohash)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "movie"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tv"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "game"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unmatched"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9a9893"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Latest micro-batches (Spark Structured Streaming \u2192 PostgreSQL)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT batch_id, rows, applied_at FROM demo.stream_batches ORDER BY batch_id DESC LIMIT 12"
        }
      ]
    }
  ]
}