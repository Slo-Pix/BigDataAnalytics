{
  "uid": "live-swarm",
  "title": "Live Torrent Swarms (speed layer)",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "torrent-bda",
    "streaming"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Torrents tracked",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT infohash) FROM swarm_latest"
        }
      ]
    },
    {
      "id": 2,
      "title": "Seeders right now (max over trackers)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(s) FROM (SELECT max(seeders) s FROM swarm_latest GROUP BY infohash) t"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rows ingested (selected range)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(rows) FROM swarm_minute WHERE $__timeFilter(minute)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Micro-batches applied",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM stream_batches"
        }
      ]
    },
    {
      "id": 5,
      "title": "Stream throughput: scrape rows per minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT minute AS time, sum(rows) AS rows FROM swarm_minute\n             WHERE $__timeFilter(minute) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Average seeders per torrent, by tracker (hourly)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', minute) AS time, tracker,\n                    sum(total_seeders)::float / nullif(sum(rows), 0) AS avg_seeders\n             FROM swarm_minute WHERE $__timeFilter(minute) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "title": "Largest swarms right now",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(t.title, l.infohash) AS torrent, t.category,\n                    max(l.seeders) AS seeders, max(l.leechers) AS leechers, max(l.completed) AS completed,\n                    max(l.scraped_at) AS last_seen\n             FROM swarm_latest l LEFT JOIN torrents t USING (infohash)\n             GROUP BY 1, 2 ORDER BY seeders DESC LIMIT 25"
        }
      ]
    },
    {
      "id": 8,
      "title": "Seeders by category right now",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torrentdb"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torrentdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(t.category, 'unmatched') AS category, sum(s) AS seeders\n             FROM (SELECT infohash, max(seeders) s FROM swarm_latest GROUP BY 1) l\n             LEFT JOIN torrents t USING (infohash) GROUP BY 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      }
    }
  ]
}